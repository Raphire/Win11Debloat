<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="%LANG:AboutTitle%"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False">

    <Border Style="{DynamicResource ModalCardBorderStyle}">
        
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" x:Name="TitleBar" Style="{DynamicResource ModalTitleBarStyle}">
                <TextBlock Text="%LANG:AboutTitle%"
                           Style="{DynamicResource ModalTitleTextStyle}"/>
            </Grid>

            <!-- Message Content -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Message Text -->
                <Grid Grid.Row="0" Margin="20,4,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Version -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                            Text="%LANG:AboutVersionLabel%"
                            Style="{DynamicResource ModalInfoLabelTextStyle}"/>
                    <TextBlock x:Name="VersionText"
                            Grid.Row="0" Grid.Column="1"
                            Text="0.0.0"
                            Style="{DynamicResource ModalInfoValueTextStyle}"/>
                    
                    <!-- Author -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                            Text="%LANG:AboutAuthorLabel%"
                            Style="{DynamicResource ModalInfoLabelTextStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                            Text="Raphire"
                            Style="{DynamicResource ModalInfoValueTextStyle}"/>
                    
                    <!-- Project Link -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                            Text="%LANG:AboutProjectLabel%"
                            Style="{DynamicResource ModalInfoLabelTextStyle}"
                            Margin="0,0,16,0"/>
                    <TextBlock
                            Grid.Row="2" Grid.Column="1"
                            FontSize="13"
                            Margin="0,0,0,0">
                        <Hyperlink x:Name="ProjectLink"
                                   Style="{DynamicResource InlineHyperlinkStyle}"
                                   AutomationProperties.Name="https://github.com/Raphire/Win11Debloat">https://github.com/Raphire/Win11Debloat</Hyperlink>
                    </TextBlock>
                </Grid>

                <!-- Separator -->
                <Border Grid.Row="1" 
                        Height="1" 
                        Background="{DynamicResource AppBorderColor}"
                        Margin="20,0"/>

                <!-- Content -->
                <StackPanel Grid.Row="2" Margin="20,16,20,16">
                    <!-- Donation Message -->
                    <TextBlock Text="%LANG:AboutDonationMessage%"
                            FontSize="14"
                            Foreground="{DynamicResource AppFgColor}"
                            TextWrapping="Wrap"
                            Margin="0,0,0,15"/>

                    <!-- Ko-fi Link -->
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="KofiLinkIcon"
                                Grid.Column="0"
                                FontSize="16"
                                Style="{DynamicResource HyperlinkStyle}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                FontFamily="{DynamicResource AppIconFontFamily}"
                                Text="&#xEB52;" 
                                Foreground="{DynamicResource TitleBarCloseHoverColor}"
                                Margin="0,0,8,0"/>
                        
                        <TextBlock
                                Grid.Column="1"
                                FontSize="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold">
                            <Hyperlink x:Name="KofiLink"
                                       Style="{DynamicResource InlineHyperlinkStyle}"
                                       AutomationProperties.Name="%LANG:AboutKofiLink%">%LANG:AboutKofiLink%</Hyperlink>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Button Panel -->
            <Border Grid.Row="2" Style="{DynamicResource ModalFooterBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CloseButton"
                            Grid.Column="1"
                            Content="%LANG:TitleBarClose%"
                            AutomationProperties.Name="%LANG:TitleBarClose%"
                            Style="{DynamicResource ModalSecondaryStretchedButtonStyle}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
